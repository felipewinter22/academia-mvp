# Copie este arquivo para ".env" e ajuste os valores conforme seu ambiente

# String de conexão do PostgreSQL usada pelo Prisma
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/academia_db?schema=public"

# Porta em que a API vai rodar
PORT=3001
